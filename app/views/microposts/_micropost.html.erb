<li id="micropost-<%= micropost.id %>">
    <%= link_to gravatar_for(micropost.user, size: 50), micropost.user %>
    <span class="user"><%= link_to micropost.user.name, micropost.user %></span>
    <span class="content">
        <%= micropost.content %>
        <%= image_tag micropost.image if micropost.image.attached? %>
    </span>
    <span class="timestamp">
        Posted <%= time_ago_in_words(micropost.created_at) %> ago.
        <% if current_user?(micropost.user) %>
            <!-- 
                link_toの第二引数はURLだがmicropostを入れると自動的にアクションと結び付けてくれる、ちなみにmicropost_path(micropost)と入れても同じ 
                第三引数のdata:~~はHotwireの書き方。通常aタグはGETしか送れないものをDELETEリクエストを送信するため
            -->
            <%= link_to "delete",micropost,data: {"turbo-method": :delete,turbo_confirm: "You sure?"} %>
        <% end %> 
    </span>
</li>
